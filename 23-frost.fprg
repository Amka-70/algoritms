<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="23-frost"/>
        <attribute name="authors" value="Alijonov-Aminjon"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-27 10:18:43 "/>
        <attribute name="created" value="QWxpam9ub3YtQW1pbmpvbjtQQy0wMjsyMDI2LTExLTI3OyIwOTo1NDo0NiAiOzMwODk="/>
        <attribute name="edited" value="QWxpam9ub3YtQW1pbmpvbjtQQy0wMjsyMDI2LTExLTI3OyIxMDoxODo0MyAiOzE7MzE4Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;&#1047;&#1072; &#1089;&#1082;&#1086;&#1083;&#1100;&#1082;&#1086; &#1076;&#1085;&#1077;&#1081;&quot;" newline="True"/>
            <declare name="days" type="Integer" array="False" size=""/>
            <input variable="days"/>
            <declare name="frost" type="Integer" array="False" size=""/>
            <assign variable="frost" expression="0"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="1" end="days" direction="inc" step="1">
                <output expression="&quot;&#1050;&#1072;&#1082;&#1072;&#1103; &#1090;&#1077;&#1084;&#1087;&#1077;&#1088;&#1072;&#1090;&#1091;&#1088;&#1072; &#1085;&#1072; &quot; &amp; i &amp;  &quot; &#1085;&#1086;&#1103;&#1073;&#1088;&#1103;&quot;" newline="True"/>
                <declare name="temperatura" type="Integer" array="False" size=""/>
                <input variable="temperatura"/>
                <if expression="temperatura &lt;0">
                    <then>
                        <assign variable="frost" expression="frost + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;&#1050;&#1086;&#1083;&#1080;&#1095;&#1077;&#1089;&#1090;&#1074;&#1086; &#1084;&#1086;&#1088;&#1086;&#1079;&#1085;&#1099;&#1093; &#1076;&#1085;&#1077;&#1081; &#1074; &#1085;&#1086;&#1103;&#1073;&#1088;&#1077; &quot; &amp; frost" newline="True"/>
        </body>
    </function>
</flowgorithm>
