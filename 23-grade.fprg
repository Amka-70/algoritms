    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;&#1057;&#1082;&#1086;&#1083;&#1100;&#1082;&#1086; &#1073;&#1072;&#1083;&#1083;&#1086;&#1074;&quot;" newline="True"/>
            <declare name="point" type="Integer" array="False" size=""/>
            <input variable="point"/>
            <if expression="not (point &gt;= 0 and point &lt;= 100)">
                <then>
                    <output expression="&quot;&#1041;&#1072;&#1083;&#1083; &#1074;&#1074;&#1077;&#1076;&#1105;&#1085; &#1085;&#1077;&#1074;&#1077;&#1088;&#1085;&#1086;.&#1052;&#1086;&#1078;&#1077;&#1090; &#1073;&#1099;&#1090;&#1100; &#1086;&#1090; 0 &#1076;&#1086; 100&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="point &gt;=85">
                        <then>
                            <output expression="&quot;&#1054;&#1094;&#1077;&#1085;&#1082;&#1072; 5&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="point &gt;= 70">
                                <then>
                                    <output expression="&quot;&#1054;&#1094;&#1077;&#1085;&#1082;&#1072; 4&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="point&gt;=50">
                                        <then>
                                            <output expression="&quot;&#1054;&#1094;&#1077;&#1085;&#1082;&#1072; 3&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;&#1054;&#1094;&#1077;&#1085;&#1082;&#1072; 2&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
